---
import Layout from "../layouts/Layout.astro";
import resumeData from "../shared/data/resume-data";
import resumeJson from "../../data/reactive_resume-cm9y3onk32kw5q9p3b1739swk.json";

// Get contact information from resume data
const { email, phone, location } = resumeData.contact;

// Get social media profiles
const profiles = resumeJson.sections.profiles.items.map(profile => ({
  network: profile.network,
  url: profile.url.href,
  icon: profile.icon,
  username: profile.username
}));

// Form submission handling will be done client-side
---

<Layout title="Contact - Jimmy VUIDART">
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="mb-12 text-center">
        <h1 
          class="mb-4 bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text font-['Montserrat',sans-serif] text-4xl font-bold text-transparent md:text-5xl"
          data-aos="fade-up"
        >
          Get in Touch
        </h1>
        <p 
          class="mx-auto max-w-2xl text-lg text-slate-600"
          data-aos="fade-up" 
          data-aos-delay="100"
        >
          Feel free to reach out for collaborations, questions, or just to say hello!
        </p>
      </div>

      <!-- Top Section: Social Media and Contact Info -->
      <div 
        class="mb-16 grid gap-8 md:grid-cols-2 lg:grid-cols-4"
        data-aos="fade-up" 
        data-aos-delay="200"
      >
        <!-- Email -->
        <div class="rounded-xl bg-white p-6 shadow-lg transition-transform hover:scale-105">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-indigo-100 text-indigo-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="mb-2 text-xl font-semibold">Email</h3>
          <a href={`mailto:${email}`} class="text-indigo-600 hover:underline">{email}</a>
        </div>

        <!-- Phone -->
        <div class="rounded-xl bg-white p-6 shadow-lg transition-transform hover:scale-105">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-indigo-100 text-indigo-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <h3 class="mb-2 text-xl font-semibold">Phone</h3>
          <a href={`tel:${phone}`} class="text-indigo-600 hover:underline">{phone}</a>
        </div>

        <!-- Location -->
        <div class="rounded-xl bg-white p-6 shadow-lg transition-transform hover:scale-105">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-indigo-100 text-indigo-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="mb-2 text-xl font-semibold">Location</h3>
          <p class="text-slate-600">{location}</p>
        </div>

        <!-- Social Media -->
        <div class="rounded-xl bg-white p-6 shadow-lg transition-transform hover:scale-105">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-indigo-100 text-indigo-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
          </div>
          <h3 class="mb-2 text-xl font-semibold">Connect</h3>
          <div class="flex space-x-3">
            {profiles.map((profile) => (
              <a 
                href={profile.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition-colors hover:bg-indigo-600 hover:text-white"
                aria-label={`Visit my ${profile.network} profile`}
              >
                {profile.network === "LinkedIn" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                  </svg>
                )}
                {profile.network === "GitHub" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                  </svg>
                )}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Bottom Section: Contact Form -->
      <div 
        class="mx-auto max-w-3xl rounded-xl bg-white p-8 shadow-xl"
        data-aos="fade-up" 
        data-aos-delay="300"
      >
        <h2 class="mb-6 text-2xl font-bold text-slate-800">Send Me a Message</h2>
        <form id="contact-form" class="space-y-6">
          <div class="grid gap-6 md:grid-cols-2">
            <div>
              <label for="name" class="mb-2 block text-sm font-medium text-slate-700">Your Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full rounded-lg border border-slate-300 px-4 py-2 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200"
                placeholder="John Doe"
              />
            </div>
            <div>
              <label for="email" class="mb-2 block text-sm font-medium text-slate-700">Your Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full rounded-lg border border-slate-300 px-4 py-2 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200"
                placeholder="john@example.com"
              />
            </div>
          </div>
          <div>
            <label for="subject" class="mb-2 block text-sm font-medium text-slate-700">Subject</label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              class="w-full rounded-lg border border-slate-300 px-4 py-2 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200"
              placeholder="How can I help you?"
            />
          </div>
          <div>
            <label for="message" class="mb-2 block text-sm font-medium text-slate-700">Message</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full rounded-lg border border-slate-300 px-4 py-2 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200"
              placeholder="Your message here..."
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full rounded-lg bg-gradient-to-r from-indigo-600 to-purple-600 px-6 py-3 text-center font-medium text-white shadow-md transition-all hover:from-indigo-700 hover:to-purple-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </section>

  <script>
    // Simple form handling
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('contact-form');

      form.addEventListener('submit', (e) => {
        e.preventDefault();

        // In a real application, you would send the form data to a server
        // For now, we'll just show an alert
        alert('Thank you for your message! This is a demo form, so no message was actually sent.');
        form.reset();
      });
    });
  </script>
</Layout>
